//TSTLAZY  JOB (SYS),'LIBC370 564',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #564 - the standard streams open on first use.  See
//* test/mvs/tstlazy.c.  LZxxx: this tree's libc.a; LRxxx: the
//* installed one (red).  No step has a SYSTERM DD, and only IN has
//* SYSIN: an eager start-up allocates a SYSOUT data set and NULLFILE
//* there (JESYSMSG).  The verdicts are TSTLAZY lines in the job log.
//* Run:     mvsdev JOB02392, 2026-10-16: G* all CC 0000, every
//*          TSTLAZY verdict PASS; R* (2.14.0) fail where a stream
//*          must stay closed; GENV stderr LRECL 99 (RENV 255);
//*          __rtinit 2.4 ms (GSTART) vs 20.3 ms (RSTART).
//* GCCALL/GCCNOC/GCCNOT rerun the @@CCALL probes (tstccall.jcl) on
//* this tree's libc.a: @@CCALL's environment shares __rtinit().
//*
//GOUT     EXEC PGM=LZOUT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//ROUT     EXEC PGM=LROUT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//GERR     EXEC PGM=LZERR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//RERR     EXEC PGM=LRERR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//GIN      EXEC PGM=LZIN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
SYSINREC
/*
//RIN      EXEC PGM=LRIN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
SYSINREC
/*
//GPRE     EXEC PGM=LZPRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//MYOUT    DD  SYSOUT=*
//RPRE     EXEC PGM=LRPRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//MYOUT    DD  SYSOUT=*
//GFRE     EXEC PGM=LZFRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//OUT2     DD  SYSOUT=*
//RFRE     EXEC PGM=LRFRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//OUT2     DD  SYSOUT=*
//GEXIT    EXEC PGM=LZEXIT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//REXIT    EXEC PGM=LREXIT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//GNONE    EXEC PGM=LZNONE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//RNONE    EXEC PGM=LRNONE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//GENV     EXEC PGM=LZERR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
SYSOUT_LRECL=99
/*
//RENV     EXEC PGM=LRERR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
SYSOUT_LRECL=99
/*
//GSTART   EXEC PGM=TSTSTART,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//OUT1     DD  SYSOUT=*
//IN1      DD  *
RECORD
/*
//RSTART   EXEC PGM=TSTSTARR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//OUT1     DD  SYSOUT=*
//IN1      DD  *
RECORD
/*
//GCCALL   EXEC PGM=TSTCCALL,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//GCCNOC   EXEC PGM=TSTCCNOC,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//GCCNOT   EXEC PGM=TSTCCNOT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LZSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
