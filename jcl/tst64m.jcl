//TST64M   JOB (SYS),'LIBC370 397',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #397 - the __64 helpers: division by 0, a negative int32
//* operand, decimal and binary strings.  See test/mvs/tst64m.c.
//* GREEN this tree, all cases; RED1-RED4 the installed library, one
//* case each.  RED1 loops there: TIME ends it (S322).
//*
//GREEN    EXEC PGM=TST64M,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.I6SCR
//RED1     EXEC PGM=TST64R1,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.I6SCR
//RED2     EXEC PGM=TST64R2,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.I6SCR
//RED3     EXEC PGM=TST64R3,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.I6SCR
//RED4     EXEC PGM=TST64R4,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.I6SCR
//
