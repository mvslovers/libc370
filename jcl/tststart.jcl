//TSTSTART JOB (SYS),'LIBC370 564',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #564 - where the C start-up spends its CPU.  A measurement:
//* see test/mvs/tststart.c.  FULL has SYSTERM and SYSIN DDs, BARE has
//* neither, so the start-up allocates a SYSOUT for stderr and NULLFILE
//* for stdin.  EMPTY/EMPTYS (an empty main, the second with __stklen
//* 16K) give the step CPU and storage in the IEFACTRT lines, 3 each.
//*
//* Run:     mvsdev JOB02385/86/87, 2026-10-16 (2.14.0); the numbers are
//*          in issue #564.
//*
//FULL     EXEC PGM=TSTSTART,REGION=4M
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//OUT1     DD  SYSOUT=*
//IN1      DD  *
RECORD
/*
//SYSTERM  DD  SYSOUT=*
//SYSIN    DD  *
RECORD
/*
//BARE     EXEC PGM=TSTSTART,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//OUT1     DD  SYSOUT=*
//IN1      DD  *
RECORD
/*
//EMPTY1   EXEC PGM=EMPTY,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//EMPTY2   EXEC PGM=EMPTY,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//EMPTY3   EXEC PGM=EMPTY,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//EMPTYS1  EXEC PGM=EMPTYS,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//EMPTYS2  EXEC PGM=EMPTYS,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
//EMPTYS3  EXEC PGM=EMPTYS,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.STSCR
//SYSPRINT DD  SYSOUT=*
