//TSTSPOLM JOB (SYS),'LIBC370 406',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #406 - the spool and checkpoint helpers.  See
//* test/mvs/tstspolm.c.  GEN makes the "checkpoint": ten 4096-byte
//* RECFM=U blocks of zeros.  GREEN this tree; RED1-RED3 the installed
//* library, one case each.
//*
//GEN      EXEC PGM=IEBDG
//SYSPRINT DD  SYSOUT=*
//SEQOUT   DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=(NEW,CATLG),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=U,BLKSIZE=4096,LRECL=4096)
//SYSIN    DD  *
 DSD OUTPUT=(SEQOUT)
 FD NAME=F1,LENGTH=4096,STARTLOC=1,FILL=X'00'
 CREATE QUANTITY=10,NAME=(F1)
 END
/*
//GREEN    EXEC PGM=TSTSPOLG,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.SPSCR
//CKPT     DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//HASPCKPT DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//RED1     EXEC PGM=TSTSPOR1,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.SPSCR
//CKPT     DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//HASPCKPT DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//RED2     EXEC PGM=TSTSPOR2,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.SPSCR
//CKPT     DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//HASPCKPT DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//RED3     EXEC PGM=TSTSPOR3,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.SPSCR
//CKPT     DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//HASPCKPT DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=SHR
//DEL      EXEC PGM=IEFBR14,COND=EVEN
//D1       DD  DSN=IBMUSER.LIBC370.SPCKPT,DISP=(OLD,DELETE)
//
