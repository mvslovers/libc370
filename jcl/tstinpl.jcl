//TSTINPL  JOB (SYS),'LIBC370 189 INPLACE',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #189 slice 2 - r+ and w+ overwrite in place (UPDAT).
//* Every case prints OK or FAIL; grep the job log for TSTINPL.
//* CC 0000 = every case OK, 0008 = at least one FAIL.
//*
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.T189.INA PURGE
  DELETE IBMUSER.LIBC370.T189.INA2 PURGE
  DELETE IBMUSER.LIBC370.T189.INB PURGE
  DELETE IBMUSER.LIBC370.T189.INC PURGE
  DELETE IBMUSER.LIBC370.T189.IN3 PURGE
  DELETE IBMUSER.LIBC370.T189.INW PURGE
  DELETE IBMUSER.LIBC370.T189.INV PURGE
  DELETE IBMUSER.LIBC370.T189.INV2 PURGE
  DELETE IBMUSER.LIBC370.T189.INM PURGE
  SET MAXCC=0
/*
//*
//ALLOC    EXEC PGM=IEFBR14
//INW      DD  DSN=IBMUSER.LIBC370.T189.INW,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//INV      DD  DSN=IBMUSER.LIBC370.T189.INV,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=VB,LRECL=84,BLKSIZE=800)
//INV2     DD  DSN=IBMUSER.LIBC370.T189.INV2,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=VB,LRECL=84,BLKSIZE=800)
//INM      DD  DSN=IBMUSER.LIBC370.T189.INM,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1,2)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADA    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
L3
L4
L5
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.INA,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADA2   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
L3
L4
L5
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.INA2,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADB    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
L3
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.INB,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADC    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
L3
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.INC,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOAD3    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
L3
L4
L5
L6
L7
L8
L9
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.IN3,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=240)
//*
//LOADM    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.INM(MEMR),DISP=SHR
//*
//S1       EXEC PGM=TSTINPL,REGION=4096K
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.T189SCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//
