//TSTVSOX  JOB (SYS),'LIBC370 623',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #623 - __vsopenx() and __vsinfo().  See test/mvs/tstvsox.c.
//* STEPLIB is the scratch PDS recvvsox.jcl restores into.  TSTVSOXG
//* uses the new functions and this tree's libc.a; TSTVSOXR, the red
//* control, uses vsopen() of release 2.24.1.
//*
//* The job defines a user catalog of its own, VSOX623.UCAT on WORK00,
//* with a master password (VSAM checks cluster passwords only in a
//* protected catalog), and in it the clusters of the probe; the last
//* step deletes all of it again.  DEFINE CLUSTER against a shared
//* user catalog has damaged that catalog with condition code 0
//* before: run this only on a system of your own.  VOLUMES may need
//* changing on another system.
//*
//* Run:     own MVS/CE container JOB00022, 2026-10-20: GREEN CC 0000,
//*          40/40; RED CC 0001, 1/3.
//*
//* RC 0 = every check passed, 1 = a check failed (the COND CODE).
//*
//* CLEAN removes what an interrupted run left; nothing there is fine.
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE VSOX623.BA CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.KS CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.ES CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.RR CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.RU CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.PW/MSPW CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE WORK00 SPACE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.UCAT/CATPW USERCATALOG
  SET MAXCC = 0
/*
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DEFINE USERCATALOG (NAME(VSOX623.UCAT) VOLUME(WORK00) -
         CYLINDERS(1 1) MASTERPW(CATPW) ATTEMPTS(0))
  DEFINE SPACE (VOLUMES(WORK00) CYLINDERS(5 1)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE CLUSTER (NAME(VSOX623.KS) INDEXED KEYS(8 0) -
         RECORDSIZE(80 80) VOLUMES(WORK00) TRACKS(2 1)) -
         DATA (NAME(VSOX623.KS.DATA) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(VSOX623.KS.INDEX)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE CLUSTER (NAME(VSOX623.ES) NONINDEXED -
         RECORDSIZE(80 100) VOLUMES(WORK00) TRACKS(2 1)) -
         DATA (NAME(VSOX623.ES.DATA) CONTROLINTERVALSIZE(2048)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE CLUSTER (NAME(VSOX623.RR) NUMBERED -
         RECORDSIZE(80 80) VOLUMES(WORK00) TRACKS(2 1)) -
         DATA (NAME(VSOX623.RR.DATA) CONTROLINTERVALSIZE(1024)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE CLUSTER (NAME(VSOX623.RU) INDEXED KEYS(4 2) REUSE -
         RECORDSIZE(80 80) VOLUMES(WORK00) TRACKS(2 1)) -
         DATA (NAME(VSOX623.RU.DATA) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(VSOX623.RU.INDEX)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE CLUSTER (NAME(VSOX623.PW) INDEXED KEYS(8 0) -
         RECORDSIZE(80 80) VOLUMES(WORK00) TRACKS(2 1) -
         READPW(RDPW) UPDATEPW(UPPW) MASTERPW(MSPW) ATTEMPTS(0)) -
         DATA (NAME(VSOX623.PW.DATA) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(VSOX623.PW.INDEX)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE CLUSTER (NAME(VSOX623.BA) INDEXED KEYS(8 0) -
         RECORDSIZE(80 80) VOLUMES(WORK00) TRACKS(2 1)) -
         DATA (NAME(VSOX623.BA.DATA) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(VSOX623.BA.INDEX)) -
         CATALOG(VSOX623.UCAT/CATPW)
/*
//*
//LOAD     EXEC PGM=IDCAMS,COND=(0,NE,DEFINE)
//STEPCAT  DD  DSN=VSOX623.UCAT,DISP=SHR
//SYSPRINT DD  SYSOUT=*
//KS       DD  *
KEY00001 FIRST OF FIVE
KEY00002 SECOND OF FIVE
KEY00003 THIRD OF FIVE
KEY00004 FOURTH OF FIVE
KEY00005 FIFTH OF FIVE
/*
//ES       DD  *
ESDS RECORD 1
ESDS RECORD 2
ESDS RECORD 3
/*
//RR       DD  *
RRDS RECORD 1
RRDS RECORD 2
RRDS RECORD 3
/*
//RU       DD  *
AA0001 REUSE ONE
AA0002 REUSE TWO
AA0003 REUSE THREE
/*
//BA       DD  *
KEY00001  ALT003 BASE ONE
KEY00002  ALT001 BASE TWO
KEY00003  ALT002 BASE THREE
/*
//SYSIN    DD  *
  REPRO INFILE(KS) OUTDATASET(VSOX623.KS)
  REPRO INFILE(ES) OUTDATASET(VSOX623.ES)
  REPRO INFILE(RR) OUTDATASET(VSOX623.RR)
  REPRO INFILE(RU) OUTDATASET(VSOX623.RU)
  REPRO INFILE(KS) OUTDATASET(VSOX623.PW/UPPW)
  REPRO INFILE(BA) OUTDATASET(VSOX623.BA)
  DEFINE ALTERNATEINDEX (NAME(VSOX623.BA.AIX) -
         RELATE(VSOX623.BA) KEYS(6 10) UNIQUEKEY UPGRADE -
         RECORDSIZE(19 19) VOLUMES(WORK00) TRACKS(1 1)) -
         DATA (NAME(VSOX623.BA.AIX.DATA)) -
         INDEX (NAME(VSOX623.BA.AIX.INDEX)) -
         CATALOG(VSOX623.UCAT/CATPW)
  DEFINE PATH (NAME(VSOX623.BA.PATH) -
         PATHENTRY(VSOX623.BA.AIX)) -
         CATALOG(VSOX623.UCAT/CATPW)
  BLDINDEX INDATASET(VSOX623.BA) OUTDATASET(VSOX623.BA.AIX)
  LISTCAT ALL CATALOG(VSOX623.UCAT/CATPW)
/*
//*
//* The red step goes first: it adds a record to VSAMRU, which the
//* green step's RST then removes with the rest.
//RED      EXEC PGM=TSTVSOXR,REGION=4M,COND=(0,NE,LOAD)
//STEPCAT  DD  DSN=VSOX623.UCAT,DISP=SHR
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.VSOXSCR
//VSAMKS   DD  DISP=SHR,DSN=VSOX623.KS
//VSAMRU   DD  DISP=SHR,DSN=VSOX623.RU
//VSAMPW   DD  DISP=SHR,DSN=VSOX623.PW
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//GREEN    EXEC PGM=TSTVSOXG,REGION=4M,COND=(0,NE,LOAD)
//STEPCAT  DD  DSN=VSOX623.UCAT,DISP=SHR
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.VSOXSCR
//VSAMKS   DD  DISP=SHR,DSN=VSOX623.KS
//VSAMES   DD  DISP=SHR,DSN=VSOX623.ES
//VSAMRR   DD  DISP=SHR,DSN=VSOX623.RR
//VSAMRU   DD  DISP=SHR,DSN=VSOX623.RU
//VSAMPW   DD  DISP=SHR,DSN=VSOX623.PW
//VSAMPA   DD  DISP=SHR,DSN=VSOX623.BA.PATH
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//CLEANUP  EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE VSOX623.BA CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.KS CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.ES CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.RR CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.RU CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.PW/MSPW CLUSTER PURGE CATALOG(VSOX623.UCAT/CATPW)
  DELETE WORK00 SPACE CATALOG(VSOX623.UCAT/CATPW)
  DELETE VSOX623.UCAT/CATPW USERCATALOG
/*
