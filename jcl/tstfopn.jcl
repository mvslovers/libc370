//TSTFOPN  JOB (SYS),'LIBC370 F5',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 size analysis F5 - the standard streams open through
//* __fpopn().  See test/mvs/tstfopn.c.  FPxxx: this tree's libc.a;
//* FRxxx: the installed one - verdicts and output must agree.  The DYN
//* steps have no SYSPRINT, SYSTERM or SYSIN: their output goes to
//* SYSOUT data sets allocated on the fly.
//* Run:     mvsdev JOB02412 (FOP rerun JOB02414), 2026-10-17: all
//*          alike FP/FR, the SYSOUT of STD and DYN identical.
//*
//NSTD     EXEC PGM=FPSTD,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSIN    DD  *
SYSIN LINE
/*
//RSTD     EXEC PGM=FRSTD,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSIN    DD  *
SYSIN LINE
/*
//NDYN     EXEC PGM=FPDYN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//RDYN     EXEC PGM=FRDYN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//NFOP     EXEC PGM=FPFOP,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//SYSPRINT DD  SYSOUT=*
//PDS      DD  DSN=&&PDSN,DISP=(NEW,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(2,1,2)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//RFOP     EXEC PGM=FRFOP,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//SYSPRINT DD  SYSOUT=*
//PDS      DD  DSN=&&PDSR,DISP=(NEW,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(2,1,2)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//NLEAN    EXEC PGM=FPLEAN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F5SCR
//SYSPRINT DD  SYSOUT=*
//
