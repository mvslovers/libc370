//TSTCRT   JOB (SYS),'LIBC370 159',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #159 - one CRT; CTHREAD IDENTIFYed only when linked.
//* See test/mvs/tstcrt.c.  STEPLIB is the scratch PDS recvcrt.jcl
//* restores into.  N = no threads, T = threads; no suffix = @@CRT0 from
//* libc.a, 0 = this tree's crt0.o, R = the installed sysroot's crt0.o
//* and crt1.o before #159 - the red controls.
//* (libc370 2.4.0 builds no crt0.o any more: the 0 and R variants were
//*  measured with 2.3.x; N and T are the ones that still apply.)
//*
//* Run:     mvsdev JOB01370, 2026-10-05: N/T/N0/T0 CC 0000 (1/1, 4/4);
//*          red NR and TR CC 0001.
//*
//* RC 0 = every check passed, 1 = a check failed (it is the COND CODE).
//*
//SN EXEC PGM=TSTCRTN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.CRTSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//ST EXEC PGM=TSTCRTT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.CRTSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//SN0 EXEC PGM=TSTCRTN0,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.CRTSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//ST0 EXEC PGM=TSTCRTT0,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.CRTSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//SNR EXEC PGM=TSTCRTNR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.CRTSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//STR EXEC PGM=TSTCRTTR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.CRTSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
