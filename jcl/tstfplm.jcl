//TSTFPLM  JOB (SYS),'LIBC370 114',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #114 - osbclose() frees the OPEN pool.  test/mvs/tstfplm.c
//* GREEN is this tree; RED, where there is one, the installed library.
//*
//* The input data set: 20 records FB 80, blocks of 800.
//MKDATA   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT2   DD  DSN=IBMUSER.LIBC370.FPLDATA,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(1,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSUT1   DD  *
TSTFPLM RECORD 01
TSTFPLM RECORD 02
TSTFPLM RECORD 03
TSTFPLM RECORD 04
TSTFPLM RECORD 05
TSTFPLM RECORD 06
TSTFPLM RECORD 07
TSTFPLM RECORD 08
TSTFPLM RECORD 09
TSTFPLM RECORD 10
TSTFPLM RECORD 11
TSTFPLM RECORD 12
TSTFPLM RECORD 13
TSTFPLM RECORD 14
TSTFPLM RECORD 15
TSTFPLM RECORD 16
TSTFPLM RECORD 17
TSTFPLM RECORD 18
TSTFPLM RECORD 19
TSTFPLM RECORD 20
/*
//GREEN    EXEC PGM=TSTFPLG,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.FPSCR
//INDD     DD  DSN=IBMUSER.LIBC370.FPLDATA,DISP=SHR,DCB=BUFNO=3
//INNP     DD  DSN=IBMUSER.LIBC370.FPLDATA,DISP=SHR
//RED      EXEC PGM=TSTFPLR,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.FPSCR
//INDD     DD  DSN=IBMUSER.LIBC370.FPLDATA,DISP=SHR,DCB=BUFNO=3
//INNP     DD  DSN=IBMUSER.LIBC370.FPLDATA,DISP=SHR
//CLEAN    EXEC PGM=IEFBR14,COND=EVEN
//D1       DD  DSN=IBMUSER.LIBC370.FPLDATA,DISP=(OLD,DELETE)
//
