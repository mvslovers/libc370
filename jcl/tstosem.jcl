//TSTOSEM  JOB (SYS),'LIBC370 412',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #412 - osxopenm()/osdopenm() read-only, the default EODAD
//* and SYNAD of osbdcb()/osddcb().  See test/mvs/tstosem.c.
//* GREEN is this tree; RED the installed library.
//*
//* IBMUSER.LIBC370.T412S: 15 records of 80 in blocks of 800, so two
//* blocks.  DD WL reads it with BLKSIZE=400: a wrong-length record.
//*
//DEL      EXEC PGM=IEFBR14
//D1       DD  DSN=IBMUSER.LIBC370.T412S,DISP=(MOD,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(1,1))
//GEN      EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
RECORD 1
RECORD 2
RECORD 3
RECORD 4
RECORD 5
RECORD 6
RECORD 7
RECORD 8
RECORD 9
RECORD 10
RECORD 11
RECORD 12
RECORD 13
RECORD 14
RECORD 15
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T412S,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(1,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//GREEN    EXEC PGM=TSTOSEG,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.OESCR
//RO       DD  DISP=SHR,DSN=IBMUSER.LIBC370.T412S
//SEQ      DD  DISP=SHR,DSN=IBMUSER.LIBC370.T412S
//WL       DD  DISP=SHR,DSN=IBMUSER.LIBC370.T412S,
//             DCB=BLKSIZE=400
//RED      EXEC PGM=TSTOSER,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.OESCR
//RO       DD  DISP=SHR,DSN=IBMUSER.LIBC370.T412S
//SEQ      DD  DISP=SHR,DSN=IBMUSER.LIBC370.T412S
//WL       DD  DISP=SHR,DSN=IBMUSER.LIBC370.T412S,
//             DCB=BLKSIZE=400
//
