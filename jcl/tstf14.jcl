//TSTF14   JOB (SYS),'LIBC370 F1F4',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 size analysis F1/F4 - names and messages built without
//* printf.  See test/mvs/tstf14.c.  F14xxx: this tree's libc.a;
//* F1Rxxx: the installed one - verdicts and console lines must agree.
//* The ABR steps end S0C1 by design.
//* Run:     mvsdev JOB02398/02400, 2026-10-17: every case alike
//*          F14/F1R; abend report identical with addresses masked;
//*          the dummy thread report loses the decimal "(n)".
//*
//NAPP     EXEC PGM=F14APP,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//PDS      DD  DSN=&&PDSN,DISP=(NEW,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(2,1,2)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//RAPP     EXEC PGM=F1RAPP,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//PDS      DD  DSN=&&PDSR,DISP=(NEW,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(2,1,2)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//NMTX     EXEC PGM=F14MTX,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//RMTX     EXEC PGM=F1RMTX,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//NDUM     EXEC PGM=F14DUM,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//RDUM     EXEC PGM=F1RDUM,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//NABR     EXEC PGM=F14ABR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//RABR     EXEC PGM=F1RABR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.F14SCR
//SYSPRINT DD  SYSOUT=*
//
