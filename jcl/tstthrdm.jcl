//TSTTHRDM JOB (SYS),'LIBC370 403',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #403 - mtxfree() and the thread helpers.  See
//* test/mvs/tstthrdm.c.  GREEN/GREEN2 this tree; RED1-RED4 the
//* installed library, one case each.
//*
//GREEN    EXEC PGM=TSTTHRDG,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.THSCR
//GREEN2   EXEC PGM=TSTTHRG2,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.THSCR
//RED1     EXEC PGM=TSTTHRR1,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.THSCR
//RED2     EXEC PGM=TSTTHRR2,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.THSCR
//RED3     EXEC PGM=TSTTHRR3,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.THSCR
//RED4     EXEC PGM=TSTTHRR4,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.THSCR
//
