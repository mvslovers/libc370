//TSTNULIN JOB (SYS),'LIBC370 277',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #277 / #254 - stdin without SYSIN at a small REGION.
//* See test/mvs/tstnulin.c.  STEPLIB is the scratch PDS recvnul.jcl
//* restores into.  TSTNUL links the fixed libc.a, TSTNULR the
//* installed sysroot libc.a.  Nnnn/Rnnn steps: no SYSIN, REGION=nnnK;
//* the lowest REGION each reaches main() at is the measurement (CC 12
//* = @@start gave up before main()).  DUMMY and DATA are controls: an
//* explicit SYSIN DD DUMMY, and instream data that must still be read.
//* mvsdev JOB01354: TSTNUL passes from 336K, TSTNULR reaches main()
//* only at 448K.
//*
//N304     EXEC PGM=TSTNUL,REGION=304K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R304     EXEC PGM=TSTNULR,REGION=304K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N320     EXEC PGM=TSTNUL,REGION=320K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R320     EXEC PGM=TSTNULR,REGION=320K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N336     EXEC PGM=TSTNUL,REGION=336K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R336     EXEC PGM=TSTNULR,REGION=336K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N352     EXEC PGM=TSTNUL,REGION=352K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R352     EXEC PGM=TSTNULR,REGION=352K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N368     EXEC PGM=TSTNUL,REGION=368K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R368     EXEC PGM=TSTNULR,REGION=368K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N384     EXEC PGM=TSTNUL,REGION=384K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R384     EXEC PGM=TSTNULR,REGION=384K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N400     EXEC PGM=TSTNUL,REGION=400K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R400     EXEC PGM=TSTNULR,REGION=400K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N416     EXEC PGM=TSTNUL,REGION=416K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R416     EXEC PGM=TSTNULR,REGION=416K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N432     EXEC PGM=TSTNUL,REGION=432K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R432     EXEC PGM=TSTNULR,REGION=432K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//N448     EXEC PGM=TSTNUL,REGION=448K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//R448     EXEC PGM=TSTNULR,REGION=448K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//DUMMY    EXEC PGM=TSTNUL,REGION=1024K,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSIN    DD  DUMMY
//DATA     EXEC PGM=TSTNUL,REGION=1024K,COND=EVEN,PARM='DATA'
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.NULSCR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSIN    DD  *
