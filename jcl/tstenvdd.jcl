//TSTENVDD JOB (SYS),'LIBC370 F3',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 size analysis F3 - SYSENV read through BSAM instead of
//* fopen().  See test/mvs/tstenvdd.c.  EDxxx: this tree's libc.a;
//* ERxxx: the installed one - the verdicts must agree.
//* Run:     mvsdev JOB02404, 2026-10-17: all 13 steps alike ED/ER.
//*
//NFB      EXEC PGM=EDFB,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.EDSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
* an MVS comment X=1
# a Unix comment X=2
FOO=bar
NUM=12                                                                  00000010
SP=a b     
NOEQ
/*
//RFB      EXEC PGM=ERFB,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.EDSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
* an MVS comment X=1
# a Unix comment X=2
FOO=bar
NUM=12                                                                  00000010
SP=a b     
NOEQ
