//TSTVSOPM JOB (SYS),'LIBC370 411',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #411 - vsopen() of a cluster an abend left open, and of a
//* lower-case DD name.  See test/mvs/tstvsopm.c.  GREEN is this tree,
//* RED the installed library; each runs after an ABENDn step that
//* leaves the ESDS open for output.  VOLUMES may need changing.
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//IN       DD  *
RECORD1 FIRST OF TWO
RECORD2 SECOND OF TWO
/*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.VSOPTST CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(IBMUSER.LIBC370.VSOPTST) -
         NONINDEXED RECORDSIZE(80 80) TRACKS(1 1) -
         VOLUMES(PUB000) UNIQUE) -
         DATA (NAME(IBMUSER.LIBC370.VSOPTST.DATA))
  REPRO INFILE(IN) OUTDATASET(IBMUSER.LIBC370.VSOPTST)
/*
//ABEND1   EXEC PGM=TSTVSOG,PARM='ABEND',COND=(0,NE,DEFINE)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.VOSCR
//VSAMESDS DD  DISP=SHR,DSN=IBMUSER.LIBC370.VSOPTST
//GREEN    EXEC PGM=TSTVSOG,COND=((0,NE,DEFINE),EVEN)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.VOSCR
//VSAMESDS DD  DISP=SHR,DSN=IBMUSER.LIBC370.VSOPTST
//ABEND2   EXEC PGM=TSTVSOG,PARM='ABEND',COND=((0,NE,DEFINE),EVEN)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.VOSCR
//VSAMESDS DD  DISP=SHR,DSN=IBMUSER.LIBC370.VSOPTST
//RED      EXEC PGM=TSTVSOR,COND=((0,NE,DEFINE),EVEN)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.VOSCR
//VSAMESDS DD  DISP=SHR,DSN=IBMUSER.LIBC370.VSOPTST
//CLEANUP  EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.VSOPTST CLUSTER PURGE
/*
//
