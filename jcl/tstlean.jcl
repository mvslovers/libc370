//TSTLEAN  JOB (SYS),'LIBC370 564',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #564 steps 3/4 - SYSENV, TZ and the library's messages
//* without stdio in the start-up.  See test/mvs/tstlean.c.  LNxxx:
//* this tree's libc.a; LRxxx: the installed one - the results must
//* agree.  Every step has SYSENV with FOO=bar and TZ=-05:00.
//* Then tststart (green/red) and the lazy-stream cases (green).
//* Run:     mvsdev JOB02396, 2026-10-16: every case green and alike
//*          LN/LR; __rtinit 0.2 ms (2.8 ms with 2.15.0).
//*
//NENV     EXEC PGM=LNENV,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//RENV     EXEC PGM=LRENV,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//NSET     EXEC PGM=LNSET,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//RSET     EXEC PGM=LRSET,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//NPRE     EXEC PGM=LNPRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//RPRE     EXEC PGM=LRPRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//NTZ      EXEC PGM=LNTZ,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//RTZ      EXEC PGM=LRTZ,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//NMEM     EXEC PGM=LNMEM,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//RMEM     EXEC PGM=LRMEM,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//NEST     EXEC PGM=LNEST,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//REST     EXEC PGM=LREST,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//NNONE    EXEC PGM=LNNONE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//RNONE    EXEC PGM=LRNONE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
FOO=bar
TZ=-05:00
/*
//GSTART   EXEC PGM=TSTSTART,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//OUT1     DD  SYSOUT=*
//IN1      DD  *
RECORD
/*
//RSTART   EXEC PGM=TSTSTARR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//OUT1     DD  SYSOUT=*
//IN1      DD  *
RECORD
/*
//ZOUT     EXEC PGM=LZOUT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//ZERR     EXEC PGM=LZERR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSENV   DD  *
SYSOUT_LRECL=99
/*
//ZIN      EXEC PGM=LZIN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
SYSINREC
/*
//ZPRE     EXEC PGM=LZPRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//MYOUT    DD  SYSOUT=*
//ZFRE     EXEC PGM=LZFRE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//OUT2     DD  SYSOUT=*
//ZEXIT    EXEC PGM=LZEXIT,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
//ZNONE    EXEC PGM=LZNONE,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.LNSCR
//SYSPRINT DD  SYSOUT=*
