//TSTAPFUN JOB (SYS),'LIBC370 402',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #402/#406 - an unauthorized caller gets EPERM / -1 from
//* super_do, super_key_do, clib_auth_cde and jescanj (iefssreq), not
//* ABEND S047.  Problem state, no APF.  See test/mvs/tstapfun.c.
//* GREEN runs all four cases; RED1-RED4 (the installed library) one
//* case each, and each ends S047 there.
//* Run:     mvsdev JOB02456, 2026-10-18: GREEN 4/4, RED1-RED4 S047.
//*
//GREEN    EXEC PGM=TSTAPFUN,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.AUSCR
//SYSPRINT DD  SYSOUT=*
//RED1     EXEC PGM=TSTAPFR1,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.AUSCR
//SYSPRINT DD  SYSOUT=*
//RED2     EXEC PGM=TSTAPFR2,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.AUSCR
//SYSPRINT DD  SYSOUT=*
//RED3     EXEC PGM=TSTAPFR3,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.AUSCR
//SYSPRINT DD  SYSOUT=*
//RED4     EXEC PGM=TSTAPFR4,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.AUSCR
//SYSPRINT DD  SYSOUT=*
//
