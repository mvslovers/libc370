//TSTJSUN  JOB (SYS),'LIBC370 142',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #142 - jesopen() with SYS1.HASPCKPT not cataloged.  See
//* test/mvs/tstjsun.c.  GREEN is this tree, RED a library before
//* the change.  No step has a JES2 DD or DYNAMNBR.
//*
//* THROWAWAY SYSTEMS ONLY: UNCAT removes the catalog entry of
//* SYS1.HASPCKPT (NOSCRATCH: the data set stays, JES2 keeps
//* running on it) and nothing puts it back.
//*
//LISTB    EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  LISTCAT ENTRIES(SYS1.HASPCKPT) ALL
/*
//GCAT     EXEC PGM=TSTJSUG,PARM='CAT',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JUSCR
//UNCAT    EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE SYS1.HASPCKPT NONVSAM NOSCRATCH
/*
//LISTA    EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  LISTCAT ENTRIES(SYS1.HASPCKPT) ALL
/*
//GUNCAT   EXEC PGM=TSTJSUG,PARM='UNCAT',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JUSCR
//RUNCAT   EXEC PGM=TSTJSUR,PARM='UNCAT',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JUSCR
//
