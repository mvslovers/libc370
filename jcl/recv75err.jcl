//TSTRCVXE JOB (SYS),'RECV TST75ERR/PRT',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* RECEIVE the #161/#165 probes (TST75ERR, TST75PRT) into their own
//* scratch PDS.  Upload the XMIT to IBMUSER.LIBC370.XEXMIT first.
//*
//DEL      EXEC PGM=IEFBR14
//D1       DD  DSN=IBMUSER.LIBC370.XESCR,DISP=(MOD,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(1,1,1))
//RECV     EXEC PGM=IKJEFT01,DYNAMNBR=20,REGION=6144K
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  RECEIVE INDSN('IBMUSER.LIBC370.XEXMIT')
/*
//
