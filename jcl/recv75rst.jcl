//TSTRCV   JOB (SYS),'RECV TST75RST',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* RECEIVE the probe into a scratch PDS, then IEBCOPY the one member into
//* the shared probe LINKLIB.  RECEIVE cannot merge into an existing PDS and
//* the LINKLIB already holds TSTJESDA, which must survive.
//*
//DEL      EXEC PGM=IEFBR14
//D1       DD  DSN=IBMUSER.LIBC370.RSTSCR,DISP=(MOD,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(1,1,1))
//*
//RECV     EXEC PGM=IKJEFT01,DYNAMNBR=20,REGION=6144K
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  RECEIVE INDSN('IBMUSER.MBT.XMIT.IN')
/*
//*
//COPY     EXEC PGM=IEBCOPY,COND=(0,NE),REGION=1024K
//SYSPRINT DD  SYSOUT=*
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//IN       DD  DSN=IBMUSER.LIBC370.RSTSCR,DISP=SHR
//OUT      DD  DSN=IBMUSER.LIBC370.PROBE.LINKLIB,DISP=SHR
//SYSIN    DD  *
  COPY OUTDD=OUT,INDD=((IN,R))
  SELECT MEMBER=TST75RST
/*
//
