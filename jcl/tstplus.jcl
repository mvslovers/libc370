//TSTPLUS  JOB (SYS),'LIBC370 189 PLUS',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #189 slice 1 - r+, w+ and a+ on real data sets and a member.
//* Every case prints OK or FAIL; grep the job log for TSTPLUS.
//* CC 0000 = every case OK, 0008 = at least one FAIL.
//*
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.T189.PLW PURGE
  DELETE IBMUSER.LIBC370.T189.PLR PURGE
  DELETE IBMUSER.LIBC370.T189.PLA PURGE
  DELETE IBMUSER.LIBC370.T189.PLB PURGE
  DELETE IBMUSER.LIBC370.T189.PLM PURGE
  DELETE IBMUSER.LIBC370.T189.PLN PURGE
  DELETE IBMUSER.LIBC370.T189.PLN2 PURGE
  DELETE IBMUSER.LIBC370.T189.PLP PURGE
  DELETE IBMUSER.LIBC370.T189.PLQ PURGE
  DELETE IBMUSER.LIBC370.T189.PLS PURGE
  SET MAXCC=0
/*
//*
//ALLOC    EXEC PGM=IEFBR14
//PLW      DD  DSN=IBMUSER.LIBC370.T189.PLW,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//PLM      DD  DSN=IBMUSER.LIBC370.T189.PLM,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1,2)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//PLP      DD  DSN=IBMUSER.LIBC370.T189.PLP,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//PLQ      DD  DSN=IBMUSER.LIBC370.T189.PLQ,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADR    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
L3
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PLR,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADA    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PLA,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADB    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PLB,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADS    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PLS,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADR2   EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
L2
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PLM(MEMR),DISP=SHR
//*
//S1       EXEC PGM=TSTPLUS,REGION=4096K
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.T189SCR
//SYSAPP   DD  SYSOUT=*
//DDMEM    DD  DISP=SHR,DSN=IBMUSER.LIBC370.T189.PLM(MEMJ)
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//
