//TSTKSDS  JOB (SYS),'LIBC370 514',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #514 - a KSDS opened for dynamic access: vswrite() puts
//* direct, vsread() of a missing key reports 16.  See test/mvs/
//* tstksds.c.  STEPLIB is the scratch PDS recvksds.jcl restores into.
//* TSTKSDS links this tree's libc.a, TSTKSDSR 2.10.0's - the red
//* control.  Each step gets a fresh, empty cluster.  VOLUMES may need
//* changing on another system.
//*
//* Run:     dev1 JOB02108, 2026-10-12: GREEN CC 0000, 13/13;
//*          RED CC 0001, 7/13.
//*
//* RC 0 = every check passed, 1 = a check failed (the COND CODE).
//*
//DEF1     EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.KSDSTST CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(IBMUSER.LIBC370.KSDSTST) -
         INDEXED KEYS(8 0) RECORDSIZE(80 80) TRACKS(1 1) -
         SHAREOPTIONS(1 3) VOLUMES(PUB000) UNIQUE) -
         DATA (NAME(IBMUSER.LIBC370.KSDSTST.DATA)) -
         INDEX (NAME(IBMUSER.LIBC370.KSDSTST.INDEX))
/*
//GREEN    EXEC PGM=TSTKSDS,REGION=4M,COND=(0,NE,DEF1)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.KSSCR
//KSDS     DD  DISP=OLD,DSN=IBMUSER.LIBC370.KSDSTST
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//DEF2     EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.KSDSTST CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(IBMUSER.LIBC370.KSDSTST) -
         INDEXED KEYS(8 0) RECORDSIZE(80 80) TRACKS(1 1) -
         SHAREOPTIONS(1 3) VOLUMES(PUB000) UNIQUE) -
         DATA (NAME(IBMUSER.LIBC370.KSDSTST.DATA)) -
         INDEX (NAME(IBMUSER.LIBC370.KSDSTST.INDEX))
/*
//RED      EXEC PGM=TSTKSDSR,REGION=4M,COND=EVEN
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.KSSCR
//KSDS     DD  DISP=OLD,DSN=IBMUSER.LIBC370.KSDSTST
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//CLEANUP  EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.KSDSTST CLUSTER PURGE
/*
