//TSTJSOP  JOB (SYS),'LIBC370 142',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #142 - jesopen() without a HASPCKPT DD.  See
//* test/mvs/tstjsop.c.  GREEN is this tree, RED a library before
//* the change.  NOCAT leaves IBMUSER.JX142.NOCAT uncataloged
//* (DISP=(NEW,KEEP)) for the OBTAIN scan; run in a fresh system.
//* No DYNAMNBR: a server's step does not have one either.
//*
//NOCAT    EXEC PGM=IEFBR14
//D1       DD  DSN=IBMUSER.JX142.NOCAT,DISP=(NEW,KEEP),
//             UNIT=SYSDA,SPACE=(TRK,(1,1))
//GNODD    EXEC PGM=TSTJSOG,PARM='NODD',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JXSCR
//GDD      EXEC PGM=TSTJSOG,PARM='DD',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JXSCR
//HASPCKPT DD  DISP=SHR,DSN=SYS1.HASPCKPT
//HASPACE1 DD  DISP=SHR,DSN=SYS1.HASPACE
//RNODD    EXEC PGM=TSTJSOR,PARM='NODD',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JXSCR
//RDD      EXEC PGM=TSTJSOR,PARM='DD',REGION=4M,COND=EVEN,
//             TIME=(0,30)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.JXSCR
//HASPCKPT DD  DISP=SHR,DSN=SYS1.HASPCKPT
//HASPACE1 DD  DISP=SHR,DSN=SYS1.HASPACE
//
