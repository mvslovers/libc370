//TSTATAN JOB (SYS),'LIBC370 675',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #675 - atan() of a negative argument; test/mvs/tstatan.c.
//* GREEN is this tree, all cases.  RED is the library before #675, one
//* step per case group (P N S Q), as each group loops at its first
//* bad case: TIME=(0,5) ends it with S322.
//*
//GREEN    EXEC PGM=TSTATNG,REGION=4M,COND=EVEN,TIME=(0,10)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.ATNSCR
//REDP     EXEC PGM=TSTATNR,PARM='P',REGION=4M,COND=EVEN,TIME=(0,5)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.ATNSCR
//REDN     EXEC PGM=TSTATNR,PARM='N',REGION=4M,COND=EVEN,TIME=(0,5)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.ATNSCR
//REDS     EXEC PGM=TSTATNR,PARM='S',REGION=4M,COND=EVEN,TIME=(0,5)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.ATNSCR
//REDQ     EXEC PGM=TSTATNR,PARM='Q',REGION=4M,COND=EVEN,TIME=(0,5)
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.ATNSCR
//
