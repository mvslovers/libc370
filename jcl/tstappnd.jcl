//TSTAPPND JOB (SYS),'LIBC370 189 APPEND',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1)
//*
//* libc370 #189 - does fopen(..., "a") append, or truncate?
//*
//* Measures, decides nothing.  Five targets are pre-loaded with one
//* record "L1"; the probe opens each with "a", writes "L2", reads it
//* back and prints APPEND (L1,L2), TRUNC (L2), REFUSED, CREATED (for
//* the two targets that do not exist) or OTHER.  DDMOD (DISP=MOD) is
//* the control.  Grep the job log for TSTAPPND.
//*
//* CC 0000 = every case was measured, whatever the verdicts are.
//*
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE IBMUSER.LIBC370.T189.SEQA PURGE
  DELETE IBMUSER.LIBC370.T189.SEQC PURGE
  DELETE IBMUSER.LIBC370.T189.SEQD PURGE
  DELETE IBMUSER.LIBC370.T189.PDS  PURGE
  DELETE IBMUSER.LIBC370.T189.SEQN PURGE
  SET MAXCC=0
/*
//*
//ALLOC    EXEC PGM=IEFBR14
//PDS      DD  DSN=IBMUSER.LIBC370.T189.PDS,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1,2)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADA    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.SEQA,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADC    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.SEQC,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADD    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.SEQD,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(2,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//LOADM    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PDS(MEMA),DISP=SHR
//*
//LOADB    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  *
L1
/*
//SYSUT2   DD  DSN=IBMUSER.LIBC370.T189.PDS(MEMB),DISP=SHR
//*
//S1       EXEC PGM=TSTAPPND,REGION=4096K
//STEPLIB  DD  DISP=SHR,DSN=IBMUSER.LIBC370.T189SCR
//DDOLD    DD  DISP=OLD,DSN=IBMUSER.LIBC370.T189.SEQC
//DDMOD    DD  DISP=MOD,DSN=IBMUSER.LIBC370.T189.SEQD
//DDMEM    DD  DISP=SHR,DSN=IBMUSER.LIBC370.T189.PDS(MEMB)
//SYSAPP   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//
